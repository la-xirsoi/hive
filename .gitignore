# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# --- Hive backend (Gradle / Kotlin) ---
build/
.gradle/
!**/gradle/wrapper/gradle-wrapper.jar
# IDE compiler output. NOTE: this pattern matches *any* directory called `out`,
# which includes the hexagonal architecture's outbound adapter package
# (`hive.adapter.out`). Without the negations below, the entire persistence
# layer -- source and tests -- is silently untracked and no amount of `git add`
# will pick it up.
# IDE compiler output. Anchored with a leading slash: an unanchored `out/`
# also matches the hexagonal package hive/adapter/out/, which silently made the
# entire outbound adapter uncommittable.
/out/
/backend/out/

# --- Hive frontend (Node / Angular) ---
node_modules/
dist/
coverage/
.angular/
*.tsbuildinfo
.npm/

# --- Local environment & secrets ---
.env
.env.local
containers/.env
certs/
*.pem
*.key
*.pfx
!containers/.env.example

# Agent worktrees (transient; Windows long paths make these hard to remove)
.claude/worktrees/
