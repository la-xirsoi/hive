# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# --- SQL Server 2022 --------------------------------------------------------
# Must satisfy the SQL Server password policy: at least 8 characters with
# three of { uppercase, lowercase, digit, symbol }. The container refuses to
# start otherwise, and the failure message is easy to miss in the log.
MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!Pass

# --- Identity provider ------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_Str0ng!Pass

# The issuer URI the backend validates JWTs against. This must be reachable
# from INSIDE the backend container, and it must exactly match the `iss` claim
# the identity provider mints -- a mismatch here is the single most common
# cause of a 401 that looks like a configuration problem elsewhere.
OAUTH_ISSUER_URI=https://idp:8443/realms/hive

# --- TLS --------------------------------------------------------------------
# Password protecting the backend's PKCS#12 keystore, produced by
# scripts/generate-certs.sh. Use the same value there and here.
CERT_PASSWORD=CHANGE_ME_Str0ng!Pass
