# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# --- SQL Server 2022 --------------------------------------------------------
# Must satisfy the SQL Server password policy: at least 8 characters with
# three of { uppercase, lowercase, digit, symbol }. The container refuses to
# start otherwise, and the failure message is easy to miss in the log.
MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!Pass

# --- Identity provider ------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_Str0ng!Pass

# The public origin of the whole stack: the address you type in the browser.
# Everything is served from it -- the SPA at /, the API at /api, the identity
# provider at /idp -- so this one value settles the issuer the SPA uses, the
# `iss` claim Keycloak mints and the claim the backend requires. They cannot
# drift apart, which is what makes the usual mysterious 401 impossible here.
#
# Change it only together with the frontend's published port in compose.yaml
# and the redirect URIs in idp/realm-hive.json.
OAUTH_PUBLIC_ORIGIN=https://localhost:8444

# --- TLS --------------------------------------------------------------------
# Password protecting the backend's PKCS#12 keystore, produced by
# scripts/generate-certs.sh. Use the same value there and here.
CERT_PASSWORD=CHANGE_ME_Str0ng!Pass
