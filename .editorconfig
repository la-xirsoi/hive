root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,js,json,html,scss,css,yaml,yml}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
